---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 页头统计与全站其它 rd- 页一致：真实计数，不是装饰
const articles = await getCollection('articles', ({ data }) => !data.draft);
const garden = await getCollection('garden');
const tagSet = new Set([...articles, ...garden].flatMap((e) => e.data.tags));
const stats = { a: articles.length, g: garden.length, t: tagSet.size };

// 「剪藏→提炼→织网→归来」是真实的生产序列，故沿用归图的编号印戳
const steps = [
  { zh: '剪藏', note: '读到的好句子、好文章，先存进收件箱。' },
  { zh: '提炼', note: '消化成能独立成立的原子笔记，建链打标。' },
  { zh: '织网', note: '笔记之间互相牵连，长成一座数字花园。' },
  { zh: '归来', note: '主题够密了，编译成一篇文章，发布到这里。' },
];
const nums = ['壹', '贰', '叁', '肆'];
---
<BaseLayout title="关于 · 归来" description="「归来」是什么，以及它是怎么从一个人的笔记里长出来的。">
  <header class="rd-head rd-reveal" style="display:block">
    <span class="rd-mark" aria-hidden="true" data-parallax="-0.05" style="font-size:200px;top:-15%">关</span>
    <div class="rd-head-text" style="max-width:none">
      <p class="rd-kicker">关于 · About</p>
      <div class="rd-title-row">
        <h1 class="rd-title">关于</h1>
        <span class="rd-seal" aria-hidden="true"><span>关</span></span>
      </div>
      <p class="rd-lede" style="max-width:34em">「归来」是什么，以及它是怎么从一个人的笔记里长出来的。</p>
      <div class="rd-stats" style="margin-top:22px">
        <div class="rd-stat"><span class="rd-stat-num">{stats.a}</span><span class="rd-stat-lab">篇文章</span></div>
        <div class="rd-stat"><span class="rd-stat-num">{stats.g}</span><span class="rd-stat-lab">则花园</span></div>
        <div class="rd-stat"><span class="rd-stat-num">{stats.t}</span><span class="rd-stat-lab">个标签</span></div>
      </div>
    </div>
  </header>

  <!-- 签名元素：把站名当词条解释 -->
  <div class="rd-def rd-reveal">
    <div class="rd-def-seal" aria-hidden="true"><span>归</span></div>
    <div class="rd-def-gloss">
      <p class="rd-def-word">归来<span class="py">guī lái</span></p>
      <p class="rd-def-pos">〔动〕</p>
      <p class="rd-def-def">回到原来的地方；回来。</p>
      <p class="rd-def-mine">在这里——把读过、想过、值得留下的，带回同一处安放。</p>
    </div>
  </div>

  <div class="rd-manifesto rd-reveal">
    <p>「归来」是一个人的写作博客，也是一座数字花园。前者收存我愿意写长一点、想清楚再留下的东西；后者是还在生长、彼此牵连的笔记——不求写完，只求别丢。</p>
    <p>我把读到的句子、半成形的念头先剪存下来，慢慢消化成一篇篇能独立成立的小笔记，再让它们互相链接、织成一张网。等某个主题长得够密，就编译成一篇文章，推到这里。所以你在「文章」里读到的，多半先在「花园」里发过芽。</p>
    <p>取名「归来」，是因为信息太容易擦肩而过。记录、思考，最后总要有个归处——这个站，就是那个归处。</p>
  </div>

  <div class="rd-sec-head rd-reveal">
    <p class="rd-sec-kick">如何生长 · How it grows</p>
    <h2 class="rd-sec-title">这个站怎么长出来的</h2>
  </div>
  <div class="rd-flow rd-reveal">
    <span class="rd-flow-rail" aria-hidden="true"></span>
    {steps.map((s, i) => (
      <div class="rd-flow-step">
        <span class="rd-flow-stamp"><span>{nums[i]}</span></span>
        <div class="rd-flow-body">
          <b>{s.zh}</b>
          <span>{s.note}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="rd-sec-head rd-reveal">
    <p class="rd-sec-kick">保持联系 · Stay in touch</p>
    <h2 class="rd-sec-title">找我 · 订阅</h2>
  </div>
  <div class="rd-contact rd-reveal">
    <div class="rd-contact-id">
      <span class="rd-contact-avatar" aria-hidden="true"><span>归</span></span>
      <div>
        <div class="rd-contact-name">Evan</div>
        <div class="rd-contact-role">Writer · Gardener</div>
      </div>
    </div>
    <p class="rd-contact-line">想说话，邮件最直接；想跟着读，订 RSS。</p>
    <div class="rd-contact-social">
      <a href="https://github.com/nefelibata202" title="GitHub" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.6 2 12.3c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9 9 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.04 10.04 0 0 0 22 12.3C22 6.6 17.5 2 12 2z"/></svg></a>
      <a href="mailto:yrj8134517@gmail.com" title="Email" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14"/><path d="m3 7 9 6 9-6"/></svg></a>
      <a href="/rss.xml" title="RSS" aria-label="RSS"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor"/></svg></a>
    </div>
  </div>
</BaseLayout>

<script>
  import { enhance } from '../scripts/rd-enhance.js';
  enhance();
</script>

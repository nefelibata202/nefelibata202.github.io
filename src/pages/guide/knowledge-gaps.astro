---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';

const mdPath = join(process.cwd(), 'src/content/guide/knowledge-gaps.md');
const rawMd = readFileSync(mdPath, 'utf-8');
const body = rawMd.replace(/^---[\s\S]*?---\n/, '');

interface Section { title: string; items: string[]; id: string; }

function parseSections(text: string): Section[] {
  const secs: Section[] = [];
  let cur: Section | null = null;
  for (const line of text.split('\n')) {
    if (line.startsWith('## ')) {
      if (cur && cur.items.length > 0) secs.push(cur);
      cur = { title: line.slice(3).trim(), items: [], id: `gap-${secs.length}` };
    } else if (cur && line.startsWith('- ')) {
      cur.items.push(line.slice(2).trim());
    }
  }
  if (cur && cur.items.length > 0) secs.push(cur);
  return secs;
}

function renderText(text: string): string {
  return text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}

const sections = parseSections(body);
const total = sections.reduce((s, sec) => s + sec.items.length, 0);
---

<BaseLayout title="随时探索 · 归图" description="我愿意在碎片时间继续了解、并带去和 AI 讨论的问题。" wide>
  <div class="gaps-page sy-home">

    <a href="/guide" class="gaps-back">← <span>归图</span></a>
    <header class="gaps-header">
      <div class="gaps-title-block">
        <p class="gaps-kicker">个人知识导览 <span>· OPEN QUESTIONS</span></p>
        <h1 class="gaps-title">随时探索</h1>
        <p class="gaps-lede">挑一个此刻感兴趣的问题，带去手机上的 AI 对话里，顺着好奇心继续问下去。</p>
      </div>
      <p class="gaps-meta"><strong>{String(total).padStart(2, '0')}</strong><span>个待探索问题</span></p>
    </header>

    {sections.length > 1 && (
      <nav class="gaps-nav" aria-label="主题导航">
        {sections.map((sec, i) => (
          <a href={`#${sec.id}`} class="gaps-pill">
            <span class="gaps-pill-num">/{String(i + 1).padStart(2, '0')}</span>
            <span class="gaps-pill-label">{sec.title}</span>
            <span class="gaps-pill-count">{sec.items.length}</span>
          </a>
        ))}
      </nav>
    )}

    <div class="gaps-body">
      {sections.length === 0 ? (
        <section class="gaps-empty" aria-live="polite">
          <span class="gaps-empty-mark" aria-hidden="true">？</span>
          <div>
            <h2>这里暂时空着</h2>
            <p>只有我自己确认、确实想继续了解的问题，才会出现在这里。下次遇到好奇的事，再把它记下来。</p>
          </div>
        </section>
      ) : sections.map((sec, i) => (
        <section class="gap-section" id={sec.id}>
          <div class="gap-section-hd">
            <span class="gap-section-num">/{String(i + 1).padStart(2, '0')}</span>
            <h2 class="gap-section-title">{sec.title}</h2>
            <span class="gap-section-count">{sec.items.length} 个问题</span>
          </div>
          <ul class="gap-list">
            {sec.items.map((item, itemIndex) => (
              <li class="gap-item">
                <span class="gap-check" aria-hidden="true">/{String(itemIndex + 1).padStart(2, '0')}</span>
                <span class="gap-text" set:html={renderText(item)} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
.gaps-page {
  max-width: none;
  padding: 28px 0 76px;
}

.sy-home .gaps-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 34px;
  padding: 0 0 4px;
  border-bottom: 1px solid var(--hair);
  color: var(--muted);
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: .9rem;
  transition: color .15s, border-color .15s;
}

.sy-home .gaps-back:hover {
  color: var(--seal);
  border-color: var(--seal);
}

.gaps-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  padding: 0 0 28px;
  border-bottom: 1px solid var(--hair);
}

.gaps-title-block { max-width: 620px; }

.gaps-kicker {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 8px;
  color: var(--seal);
  font-family: var(--read);
  font-size: .9rem;
  letter-spacing: .12em;
}

.gaps-kicker::before {
  content: '';
  width: 28px;
  height: 2px;
  background: var(--seal);
}

.gaps-kicker span {
  color: var(--muted);
  font-family: var(--mono);
  font-size: .68rem;
  letter-spacing: .1em;
}

.gaps-title {
  margin: 0;
  color: var(--ink);
  font-family: var(--read);
  font-size: clamp(2.5rem, 6vw, 4.25rem);
  font-weight: 700;
  letter-spacing: .04em;
  line-height: 1.2;
}

.gaps-lede {
  max-width: 32em;
  margin: 10px 0 0;
  color: var(--muted);
  font-family: var(--read);
  font-size: 1rem;
  line-height: 1.85;
}

.gaps-meta {
  display: flex;
  flex: 0 0 auto;
  align-items: baseline;
  gap: 9px;
  margin: 0 0 5px;
  color: var(--muted);
  font-family: var(--read);
  font-size: .84rem;
  letter-spacing: .08em;
}

.gaps-meta strong {
  color: var(--seal);
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.65rem;
  font-weight: 400;
}

.gaps-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 18px;
  padding: 17px 0;
  border-bottom: 1px solid var(--hair);
}

.gaps-pill {
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
  padding: 2px 0;
  color: var(--muted);
  font-family: var(--read);
  font-size: .86rem;
  white-space: nowrap;
  transition: color .15s;
}

.gaps-pill:hover { color: var(--seal); }
.sy-home .gaps-pill { color: var(--muted); }
.sy-home .gaps-pill:hover { color: var(--seal); }
.gaps-pill-num { color: var(--seal); font-family: var(--mono); font-size: .66rem; }
.gaps-pill-count { color: var(--muted); font-family: var(--mono); font-size: .66rem; }

.gaps-body { padding-top: 38px; }

.gaps-empty {
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr);
  align-items: start;
  gap: 18px;
  max-width: 680px;
  padding: 28px 0 32px 22px;
  border-left: 2px solid var(--gold);
}

.gaps-empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 5px;
  background: var(--seal);
  box-shadow: 0 3px 12px rgba(178, 58, 46, .22);
  color: #F6F1E4;
  font-family: var(--read);
  font-size: 1.4rem;
  font-weight: 700;
  transform: rotate(-4deg);
}

.gaps-empty h2 {
  margin: 0 0 5px;
  color: var(--ink);
  font-family: var(--read);
  font-size: 1.3rem;
  letter-spacing: .05em;
}

.gaps-empty p {
  max-width: 38em;
  margin: 0;
  color: var(--muted);
  font-family: var(--read);
  font-size: .94rem;
  line-height: 1.8;
}

.gap-section {
  margin: 0 0 42px;
  scroll-margin-top: 80px;
}

.gap-section-hd {
  display: flex;
  align-items: baseline;
  gap: 14px;
  margin: 0 0 12px;
  padding: 0 0 10px;
  border-bottom: 1px solid var(--hair);
}

.gap-section-num { color: var(--seal); font-family: var(--mono); font-size: .72rem; }
.gap-section-title {
  margin: 0;
  color: var(--ink);
  font-family: var(--read);
  font-size: 1.25rem;
  letter-spacing: .08em;
}
.gap-section-count { margin-left: auto; color: var(--muted); font-family: var(--mono); font-size: .68rem; }

.gap-list { display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; }
.gap-item {
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr);
  gap: 14px;
  align-items: baseline;
  padding: 14px 8px 14px 2px;
  border-bottom: 1px solid var(--hair);
  transition: padding .15s;
}
.gap-item:hover { padding-left: 8px; }
.gap-check { color: var(--seal); font-family: var(--mono); font-size: .68rem; letter-spacing: .06em; }
.gap-text { color: var(--ink); font-family: var(--read); font-size: 1rem; line-height: 1.8; user-select: text; }
.gap-text :global(strong) { color: var(--seal); }

@media (max-width: 700px) {
  .gaps-page { padding: 22px 0 56px; }
  .gaps-back { margin-bottom: 26px; }
  .gaps-header { align-items: flex-start; flex-direction: column; gap: 14px; }
  .gaps-meta { margin: 0; }
  .gaps-body { padding-top: 28px; }
  .gaps-nav { flex-wrap: nowrap; overflow-x: auto; }
  .gap-item { grid-template-columns: 40px minmax(0, 1fr); gap: 8px; }
  .gaps-empty { grid-template-columns: 40px minmax(0, 1fr); gap: 14px; padding-left: 16px; }
  .gaps-empty-mark { width: 38px; height: 38px; }
}

@media (prefers-reduced-motion: reduce) {
  .gaps-back, .gaps-pill, .gap-item { transition: none; }
}
</style>

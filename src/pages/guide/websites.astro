---
import BaseLayout from '../../layouts/BaseLayout.astro';
import raw from '../../data/websites.json';

const categoryOrder = ['学习认知', '知识文化', '影视娱乐', '资讯阅读', '工具效率', '生活健康'];

const grouped: Record<string, typeof raw> = {};
for (const item of raw) {
  if (!grouped[item.category]) grouped[item.category] = [];
  grouped[item.category].push(item);
}

const sections = categoryOrder
  .filter((c) => grouped[c])
  .map((c) => ({ category: c, items: grouped[c] }));

const total = raw.length;
---

<BaseLayout title="网站 · 归图" description="高质量网站收藏——学习、知识、影视、资讯、工具、生活，六个领域的精选入口。">
  <div class="websites-page">

    <!-- 顶部导览 -->
    <header class="websites-header">
      <div class="websites-header-inner">
        <a href="/guide" class="websites-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          归图
        </a>
        <div class="websites-title-block">
          <p class="websites-kicker">私人甄选 · 六个领域</p>
          <h1 class="websites-title">网站</h1>
          <p class="websites-lede">互联网上真正值得反复访问的站点——不追量，只取精。{total} 座码头，随时出发。</p>
        </div>
      </div>
    </header>

    <!-- 分类导航（sticky） -->
    <nav class="cat-bar" aria-label="分类导航">
      {sections.map((s, i) => (
        <a href={`#cat-${s.category}`} class="cat-pill">
          <span class="cat-pill-num">/{String(i + 1).padStart(2, '0')}</span>
          <span class="cat-pill-label">{s.category}</span>
        </a>
      ))}
    </nav>

    <!-- 内容区 -->
    <main class="websites-body">
      {sections.map((section, i) => (
        <section class="cat-section" id={`cat-${section.category}`}>
          <div class="cat-section-header">
            <span class="cat-section-num" style="--accent: var(--gold)">/{String(i + 1).padStart(2, '0')}</span>
            <h2 class="cat-section-title">{section.category}</h2>
            <span class="cat-section-count">{section.items.length} 个站点</span>
          </div>
          <div class="site-list">
            {section.items.map((item) => {
              const hostname = (() => {
                try { return new URL(item.url).hostname.replace('www.', ''); } catch { return item.url; }
              })();
              return (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="site-link">
                  <img
                    class="site-favicon"
                    src={`https://www.google.com/s2/favicons?domain=${hostname}&sz=64`}
                    width="44"
                    height="44"
                    alt={item.name}
                    loading="lazy"
                  />
                  <span class="site-name">{item.name}</span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </main>

  </div>
</BaseLayout>

<style>
/* ── 整体容器 ── */
.websites-page {
  max-width: 960px;
  margin: 0 auto;
  padding: 40px 28px 80px;
}

/* ── 顶部导览 ── */
.websites-header {
  padding-bottom: 24px;
  border-bottom: 2px solid var(--line);
  margin-bottom: 0;
}

.websites-back {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--muted);
  text-decoration: none;
  padding: 4px 8px;
  border: 2px solid transparent;
  transition: all 0.12s;
  margin-bottom: 24px;
}

.websites-back:hover {
  color: var(--ink);
  border-color: var(--line);
  background: var(--soft);
  box-shadow: var(--shadow-sm);
}

.websites-kicker {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin: 0 0 4px;
}

.websites-title {
  font-family: var(--disp);
  font-size: clamp(2rem, 5vw, 2.8rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.05;
  margin: 0 0 12px;
}

.websites-lede {
  font-family: var(--read);
  font-size: 0.92rem;
  color: var(--muted);
  line-height: 1.7;
  margin: 0;
  max-width: 480px;
}

/* ── 分类导航（sticky） ── */
.cat-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 16px 0;
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg);
  border-bottom: 2px solid var(--hair);
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 7px 16px;
  border: 2px solid var(--hair);
  background: var(--paper);
  text-decoration: none;
  color: var(--muted);
  font-family: var(--mono);
  font-size: 0.72rem;
  transition: all 0.12s;
  white-space: nowrap;
}

.cat-pill:hover {
  color: var(--ink);
  border-color: var(--line);
  background: var(--soft);
  box-shadow: var(--shadow-sm);
}

.cat-pill-num {
  color: var(--gold);
  font-weight: 700;
}

.cat-pill-label {
  font-family: var(--zh);
  font-size: 0.75rem;
}

/* ── 内容区 ── */
.websites-body {
  padding-top: 48px;
}

.cat-section {
  margin-bottom: 56px;
  scroll-margin-top: 80px;
}

.cat-section-header {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--hair);
}

.cat-section-num {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--accent, var(--muted));
  letter-spacing: 0.1em;
  flex-shrink: 0;
}

.cat-section-title {
  font-family: var(--disp);
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: -0.01em;
  line-height: 1.2;
  margin: 0;
}

.cat-section-count {
  font-family: var(--mono);
  font-size: 0.68rem;
  color: var(--muted);
  margin-left: auto;
  flex-shrink: 0;
}

/* ── 站点列表 ── */
.site-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 8px;
  row-gap: 2px;
  padding: 16px 0;
}

.site-link {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 14px;
  text-decoration: none;
  color: var(--ink);
  border: 2px solid transparent;
  transition: border-color 0.12s, background 0.12s, box-shadow 0.12s, transform 0.12s;
}

.site-link:hover {
  border-color: var(--hair);
  background: var(--paper);
  box-shadow: var(--shadow-sm);
  transform: translate(-2px, -2px);
}

.site-favicon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  object-fit: contain;
  flex-shrink: 0;
  background: var(--paper);
  border: 1.5px solid var(--hair);
}

.site-name {
  font-family: var(--disp);
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.3;
}

/* ── 响应式 ── */
@media (max-width: 640px) {
  .site-list {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .websites-page {
    padding: 24px 16px 60px;
  }

  .cat-bar {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-right: 16px;
  }

  .cat-bar::-webkit-scrollbar {
    display: none;
  }

  .cat-section-header {
    flex-wrap: wrap;
  }
}
</style>

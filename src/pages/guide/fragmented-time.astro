---
import BaseLayout from '../../layouts/BaseLayout.astro';

const items = [
  {
    title: '看 B 站 UP 主视频',
    desc: '关注了几个优质 UP 主，碎片时间看看他们的内容，既是放松也是学习。',
    platform: 'Bilibili',
  },
  {
    title: '逛自己的网站「归来」',
    desc: '看看个人网站，思考优化点和文章。自己的网站永远有改进空间。',
    platform: 'guilai',
  },
  {
    title: '豆瓣挖掘影视和书籍',
    desc: '在豆瓣上探索想看的电影、剧集和书籍。好内容值得提前收藏。',
    platform: 'Douban',
  },
  {
    title: '微信读书',
    desc: '精力好的时候，打开微信读书看一会儿。碎片时间也能读完一本书。',
    platform: '阅读',
  },
  {
    title: '问 AI 感兴趣的问题',
    desc: '脑子里突然冒出的问题，直接问 AI。好奇心不应该被等待消磨。',
    platform: 'AI',
  },
  {
    title: 'Anki 卡片复习',
    desc: '英语表达、日语单词、知识点……每天复习几张卡片，积少成多。',
    platform: '记忆',
  },
];
---

<BaseLayout title="碎片时间 · 归图" description="零散时间的最优解法">
  <div class="island-page">

    <header class="island-header">
      <a href="/guide" class="island-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        归图
      </a>
      <div class="island-title-block">
        <p class="island-kicker">/ 04 · FRAGMENTED TIME</p>
        <h1 class="island-title">碎片时间</h1>
        <p class="island-lede">零散时间的最优解法</p>
      </div>
    </header>

    <main class="ft-grid">
      {items.map((item, i) => (
        <div class="ft-card">
          <span class="ft-num">{String(i + 1).padStart(2, '0')}</span>
          <div class="ft-body">
            <h2 class="ft-title">{item.title}</h2>
            <p class="ft-desc">{item.desc}</p>
            <span class="ft-platform">{item.platform}</span>
          </div>
        </div>
      ))}
    </main>

  </div>
</BaseLayout>

<style>
.island-page {
  max-width: 800px;
  margin: 0 auto;
  padding: 32px 28px 80px;
}

/* ── header (mirrors [island].astro) ── */
.island-header {
  padding-bottom: 24px;
  border-bottom: 2px solid var(--line);
  margin-bottom: 0;
}

.island-back {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--muted);
  text-decoration: none;
  padding: 4px 8px;
  border: 2px solid transparent;
  transition: all 0.12s;
  margin-bottom: 20px;
}

.island-back:hover {
  color: var(--ink);
  border-color: var(--line);
  background: var(--soft);
  box-shadow: var(--shadow-sm);
}

.island-kicker {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--gold);
  letter-spacing: 0.1em;
  margin: 0 0 4px;
}

.island-title {
  font-family: var(--disp);
  font-size: clamp(2rem, 5vw, 2.8rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.05;
  margin: 0 0 10px;
}

.island-lede {
  font-family: var(--read);
  font-size: 0.9rem;
  color: var(--muted);
  margin: 0;
  line-height: 1.65;
}

/* ── 2-col card grid ── */
.ft-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  padding-top: 32px;
  animation: islandFadeIn 0.28s ease both;
}

@keyframes islandFadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.ft-card {
  display: flex;
  gap: 16px;
  padding: 22px 20px;
  border: 2px solid var(--hair);
  background: var(--paper);
  transition: border-color 0.12s, box-shadow 0.12s, transform 0.12s;
}

.ft-card:hover {
  border-color: var(--line);
  box-shadow: var(--shadow-sm);
  transform: translate(-3px, -3px);
}

.ft-num {
  font-family: var(--mono);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--gold);
  line-height: 1;
  flex-shrink: 0;
  padding-top: 2px;
}

.ft-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.ft-title {
  font-family: var(--disp);
  font-size: 0.98rem;
  font-weight: 800;
  letter-spacing: -0.01em;
  line-height: 1.3;
  margin: 0;
}

.ft-desc {
  font-family: var(--read);
  font-size: 0.83rem;
  color: var(--muted);
  line-height: 1.65;
  margin: 0;
}

.ft-platform {
  font-family: var(--mono);
  font-size: 0.6rem;
  color: var(--muted);
  padding: 2px 7px;
  border: 1.5px solid var(--hair);
  background: var(--soft);
  align-self: flex-start;
  margin-top: 2px;
}

/* ── responsive ── */
@media (max-width: 600px) {
  .island-page {
    padding: 20px 16px 60px;
  }

  .ft-grid {
    grid-template-columns: 1fr;
    padding-top: 24px;
  }
}
</style>

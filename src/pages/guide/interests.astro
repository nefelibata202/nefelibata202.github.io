---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Interest {
  id: string;
  title: string;
  subtitle?: string;
  sources: string;
  inquiry: string;
  output: string;
  example?: { title: string; href: string };
}

const interests: Interest[] = [
  {
    id: 'history',
    title: '历史故事',
    sources: '从 B 站关注的历史区创作者和历史播客入手。遇到值得追问的地方，借助 AI 找资料，再读相关专业书籍的章节。',
    inquiry: '先凭记忆讲一遍经过，挑一个想追问的「为什么」。当时的人有哪些选择？什么证据能解释他们为什么那么做？',
    output: '写一则短笔记，交代因果、关键证据和存疑处。适合讲给别人听的故事，再留一张谈资卡。',
    example: { title: '一条运河，四个主人：苏伊士的百年恩怨', href: '/articles/suez-canal/' },
  },
  {
    id: 'crime',
    title: '悬疑犯罪',
    sources: '从《天网》、犯罪播客、公众号和 YouTube、B 站视频认识案件。碰到关键细节或说法冲突，再回查公开裁判文书、官方通报或可靠报道。',
    inquiry: '梳理事件经过，找出改变判断的那条证据。最后确认了什么？哪些细节只出现在转述里？',
    output: '先记下案名、一句案情和来源。想深挖的案件，做一次两分钟口述。查证充分、值得讲的，再整理成谈资卡。',
  },
  {
    id: 'craft-beer',
    title: '精酿啤酒',
    sources: '目前主要看 YouTube，也多尝不同风格的酒。喝到想弄明白的差别，再翻自己的啤酒分类笔记或风格指南。',
    inquiry: '选两款容易混淆的酒放在一起尝。先比较香气和入口的差别，再查这些差别可能来自原料、烘焙还是发酵。',
    output: '做一条品饮对照，记下两款酒各自的香气、喝起来最明显的差别，以及下次在什么场合会点哪一款。',
    example: { title: '两杯酒都这么黑，为什么一杯干爽、一杯甜润？', href: '/garden/rediscovery-2026-11-21-why-dark-beers-taste-different/' },
  },
  {
    id: 'sports',
    title: '运动锻炼',
    subtitle: '羽毛球与跑步',
    sources: '从自己的打球和跑步体验出发。有录像就回看相似回合，跑步则记路线、分段配速和体感。遇到反复卡住的问题，再查资料或请教教练。',
    inquiry: '羽毛球挑一个反复失分的场景，看回合是从哪一拍开始被动的。跑步找同一路线的几次记录，对照分段节奏和体感。',
    output: '留一条训练复盘，写下我观察到什么、下次想试什么，以及怎么判断这次调整有没有帮助。',
    example: { title: '跑步时，手臂和躯干在忙什么？', href: '/garden/rediscovery-2026-11-19-what-arms-and-trunk-do-while-running/' },
  },
];
const description = '我怎么追历史故事、看真实案件、尝精酿、练羽毛球和跑步，又会留下什么。';
---

<BaseLayout title="兴趣 · 归图" description={description} wide>
  <div class="interests-page">
    <header class="interests-header">
      <a class="interests-back" href="/guide">← 归图</a>
      <h1>兴趣</h1>
      <p>{description}</p>
    </header>

    <nav class="interests-index" aria-label="兴趣目录">
      {interests.map(interest => <a href={`#${interest.id}`}>{interest.title}</a>)}
      <a href="#research">深入研究</a>
    </nav>

    {interests.map(interest => (
      <section class="interest" id={interest.id} aria-labelledby={`${interest.id}-title`}>
        <header>
          <h2 id={`${interest.id}-title`}>{interest.title}</h2>
          {interest.subtitle && <p class="interest-subtitle">{interest.subtitle}</p>}
        </header>

        <div>
          <dl class="interest-details">
            <div>
              <dt>资料来源</dt>
              <dd>{interest.sources}</dd>
            </div>
            <div>
              <dt>研究角度</dt>
              <dd>{interest.inquiry}</dd>
            </div>
            <div>
              <dt>输出形式</dt>
              <dd>{interest.output}</dd>
            </div>
          </dl>
          {interest.example && (
            <p class="interest-example">
              <span>已发表</span>
              <a href={interest.example.href}>{interest.example.title} <span aria-hidden="true">↗</span></a>
            </p>
          )}
        </div>
      </section>
    ))}

    <section class="interest-research" id="research" aria-labelledby="research-title">
      <h2 id="research-title">什么时候深入研究</h2>
      <p>一个问题过了几天还想追问，我就拿它做一轮研究。</p>
      <ol>
        <li><strong>先想清楚要弄懂什么。</strong> 写一句「研究完，我希望自己能解释、区分或判断什么」。</li>
        <li><strong>围绕这一问查证。</strong> 用 AI 找资料、讨论和追问，回到原始资料核对关键说法。</li>
        <li><strong>合上资料讲一遍。</strong> 用自己的话说清结论、依据和存疑处，再写成笔记。</li>
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .interests-page {
    --interest-accent: color-mix(in srgb, var(--seal) 92%, var(--ink));
    padding: 28px 0 72px;
    font-family: var(--read);
  }

  .interests-header {
    padding-bottom: 26px;
    border-bottom: 1px solid var(--hair);
  }

  .interests-back {
    display: inline-block;
    margin-bottom: 28px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--hair);
    color: var(--muted);
    font-size: .9rem;
  }

  .interests-header h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    letter-spacing: .04em;
    line-height: 1.2;
  }

  .interests-header p {
    max-width: 35em;
    margin: 12px 0 0;
    color: var(--muted);
    line-height: 1.85;
  }

  .interests-index {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hair);
  }

  .interests-index a {
    padding: 4px 0;
    color: var(--muted);
    font-size: .9rem;
  }

  .interests-back:hover,
  .interests-index a:hover,
  .interest-example a:hover {
    color: var(--interest-accent);
    border-color: var(--seal);
  }

  .interest {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--hair);
    scroll-margin-top: 24px;
  }

  .interest h2,
  .interest-research h2 {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.4;
  }

  .interest-subtitle {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: .85rem;
  }

  .interest-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
  }

  .interest-details dt {
    margin-bottom: 6px;
    color: var(--interest-accent);
    font-size: .88rem;
    font-weight: 700;
  }

  .interest-details dd {
    margin: 0;
    font-size: .94rem;
    line-height: 1.8;
  }

  .interest-example {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 3px 12px;
    margin: 16px 0 0;
    font-size: .85rem;
  }

  .interest-example > span {
    color: var(--muted);
  }

  .interest-example a {
    text-decoration: underline;
    text-decoration-color: var(--hair);
    text-underline-offset: 4px;
  }

  .interest-example a:hover {
    text-decoration-color: var(--seal);
  }

  .interest-research {
    max-width: 42rem;
    margin-top: 42px;
    padding: 6px 0 6px 20px;
    border-left: 2px solid var(--gold);
    scroll-margin-top: 24px;
  }

  .interest-research p {
    margin: 8px 0 12px;
    color: var(--muted);
  }

  .interest-research ol {
    display: grid;
    gap: 5px;
    margin: 0;
    padding-left: 1.25em;
    font-size: .94rem;
    line-height: 1.8;
  }

  .interest-research li::marker {
    color: var(--interest-accent);
  }

  @media (max-width: 850px) {
    .interest {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  @media (max-width: 620px) {
    .interests-page {
      padding: 24px 0 56px;
    }

    .interests-back {
      margin-bottom: 22px;
    }

    .interests-index {
      column-gap: 16px;
    }

    .interest-details {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .interest-details > div {
      display: grid;
      grid-template-columns: 4em minmax(0, 1fr);
      align-items: baseline;
      gap: 8px;
    }

    .interest-details dt {
      margin: 0;
    }

    .interest-research {
      margin-top: 32px;
      padding-left: 16px;
    }
  }
</style>

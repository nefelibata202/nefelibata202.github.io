---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadFood } from '../../lib/food';
import raw from '../../data/food.json';

const allItems = loadFood(raw);
const items = allItems.filter((item) => (item.status ?? 'visited') === 'visited').sort((a, b) => b.score - a.score || b.date.localeCompare(a.date));
const wishlist = allItems.filter((item) => item.status === 'wishlist').sort((a, b) => a.city.localeCompare(b.city) || a.name.localeCompare(b.name));

const cityCount = new Map<string, number>();
for (const item of allItems) cityCount.set(item.city, (cityCount.get(item.city) ?? 0) + 1);
const cities = [...cityCount.entries()].sort((a, b) => b[1] - a[1]);

const cuisineCount = new Map<string, number>();
for (const item of items) for (const cuisine of item.cuisine) cuisineCount.set(cuisine, (cuisineCount.get(cuisine) ?? 0) + 1);
const cuisines = [...new Set(allItems.flatMap((item) => item.cuisine))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const topCuisines = [...cuisineCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN')).slice(0, 5);
const scored = items.filter((item) => item.score > 0);
const avg = scored.length ? (scored.reduce((sum, item) => sum + item.score, 0) / scored.length).toFixed(1) : '—';
const dishesCount = items.reduce((sum, item) => sum + item.dishes.length, 0);

const bands = [
  { name: '殿堂', en: 'The Hall', range: '9 – 10', test: (score: number) => score >= 9 },
  { name: '佳作', en: 'Fine Picks', range: '7 – 8', test: (score: number) => score >= 7 && score < 9 },
  { name: '尚可', en: 'Worth a Try', range: '< 7', test: (score: number) => score < 7 },
].map((band) => ({ ...band, items: items.filter((item) => band.test(item.score)) })).filter((band) => band.items.length);

const dishDefault = (dishes: string[]) => dishes.join('， ');
---
<BaseLayout title="美食 · 私藏" description="私人觅食地图——去过的宝藏馆子与想去的餐厅。" wide>
  <nav class="rd-crumbs rd-reveal" aria-label="私藏内导航">
    <a href="/collections">← 私藏</a><span class="sep">/</span><span class="here">美食</span>
    <a href="/collections/media" class="food-crumb-sibling">书影</a>
  </nav>

  <header class="food-hero rd-reveal">
    <span class="rd-mark" aria-hidden="true">味</span>
    <div class="food-hero-copy">
      <p class="rd-kicker">我的私藏餐厅地图</p>
      <div class="rd-title-row"><h1 class="rd-title">美食</h1><span class="rd-seal" aria-hidden="true"><span>味</span></span></div>
      <p class="rd-lede">去过的馆子认真记，想去的餐厅慢慢攒。评分只对自己负责。</p>
      <p class="food-image-note">餐厅照片尚未提供，配图为按菜系生成的氛围示意图。</p>
    </div>
    <div class="food-hero-stats" aria-label="美食档案统计">
      <div class="rd-stat"><span class="rd-stat-num" id="rd-count">{items.length}</span><span class="rd-stat-lab">去过</span></div>
      <div class="rd-stat"><span class="rd-stat-num" id="rd-wish-count">{wishlist.length}</span><span class="rd-stat-lab">想去</span></div>
      <div class="rd-stat"><span class="rd-stat-num">{cityCount.size}</span><span class="rd-stat-lab">座城</span></div>
      <div class="rd-stat"><span class="rd-stat-num">{avg}</span><span class="rd-stat-lab">均分</span></div>
    </div>
    <img class="food-hero-dish" src="/food/hangzhou-longjing-shrimp.jpg" alt="" aria-hidden="true" />
  </header>

  <div class="food-shell">
    <aside class="food-sidebar" aria-label="美食档案概览">
      <section class="food-side-card food-score-card">
        <p class="food-side-title"><span aria-hidden="true">▤</span> 我的美食档案</p>
        <div class="food-average"><strong>{avg}</strong><span>/ 10</span></div>
        <p class="food-average-caption">收藏餐厅均分</p>
        <div class="food-score-track" aria-label={`平均评分 ${avg} 分`}><span style={`width:${Number(avg) * 10 || 0}%`}></span></div>
        <dl class="food-totals">
          <div><dt><span aria-hidden="true">▦</span> 共收藏餐厅</dt><dd>{allItems.length} 家</dd></div>
          <div><dt><span aria-hidden="true">♨</span> 去过餐厅</dt><dd>{items.length} 家</dd></div>
          <div><dt><span aria-hidden="true">♡</span> 想去餐厅</dt><dd>{wishlist.length} 家</dd></div>
          <div><dt><span aria-hidden="true">⌖</span> 覆盖城市</dt><dd>{cityCount.size} 座</dd></div>
          <div><dt><span aria-hidden="true">♧</span> 记录菜品</dt><dd>{dishesCount} 道</dd></div>
        </dl>
      </section>

      <section class="food-side-card">
        <h2 class="food-side-heading">城市分布 <span>City notes</span></h2>
        <ul class="food-city-list">
          {cities.map(([city, count]) => (
            <li><span class="food-city-dot" aria-hidden="true"></span><span>{city}</span><strong>{count}</strong></li>
          ))}
        </ul>
      </section>

      <section class="food-side-card">
        <h2 class="food-side-heading">菜系偏好 <span>Top 5</span></h2>
        <ul class="food-cuisine-list">
          {topCuisines.map(([cuisine, count]) => (
            <li><span>{cuisine}</span><span class="food-cuisine-bar"><i style={`width:${Math.round((count / (topCuisines[0]?.[1] || 1)) * 100)}%`}></i></span><strong>{count}</strong></li>
          ))}
        </ul>
      </section>
    </aside>

    <div class="food-main">
      <div class="food-filter-panel">
        <div class="food-filter-row">
          <div class="food-city-filters" id="food-city-filters" role="group" aria-label="按城市筛选">
            <span class="food-filter-label"><span aria-hidden="true">⌖</span> 城市</span>
            <button type="button" class="food-filter-chip is-on" data-city-filter="*">全部 {allItems.length}</button>
            {cities.map(([city, count]) => <button type="button" class="food-filter-chip" data-city-filter={city}>{city} {count}</button>)}
          </div>
          <label class="food-cuisine-filter"><span class="food-filter-label"><span aria-hidden="true">♨</span> 菜系</span>
            <select id="food-cuisine-filter" aria-label="按菜系筛选"><option value="*">全部菜系</option>{cuisines.map((cuisine) => <option value={cuisine}>{cuisine}</option>)}</select>
          </label>
        </div>
        <label class="food-search"><span aria-hidden="true">⌕</span><span class="sr-only">搜索餐厅、菜系或菜品</span><input id="food-search" type="search" placeholder="搜餐厅、菜系或喜欢的菜…" autocomplete="off" /></label>
      </div>

      <div id="rd-bands" class="food-results">
        <section id="rd-visited" class="food-section">
          <div class="food-section-heading">
            <div><p class="food-section-kicker">BEEN THERE</p><h2>去过的店 <span id="visited-section-count">{items.length} 家</span></h2></div>
            <span class="food-section-aside">按个人评分收档</span>
          </div>
          {bands.map((band) => (
            <section class="rd-band food-rating-band">
              <div class="rd-band-head"><h3 class="rd-band-name">{band.name}</h3><span class="rd-band-en">{band.en}</span><span class="rd-band-rule"></span><span class="rd-band-range">{band.range} 分</span></div>
              {band.items.map((f) => (
                <article class="rd-spot" data-food-spot data-status="visited" data-city={f.city} data-cuisines={f.cuisine.join('|')}>
                  <div class="rd-spot-media">
                    <img class="rd-spot-photo" src={f.image || '/food/hangzhou-longjing-shrimp.jpg'} alt={`${f.cuisine[0] || '中式'}菜系氛围图`} loading="lazy" />
                    <span class="food-image-badge">菜系示意</span>
                  </div>
                  <div class="rd-spot-content">
                    <div class="food-spot-score"><strong>{f.score.toFixed(1)}</strong><span>/ 10</span></div>
                    <div class="rd-spot-head"><h4 class="rd-spot-name">{f.name}</h4><span class="rd-spot-seal" hidden={!f.score || f.score < 9} aria-label="值得回头">回头</span></div>
                    <p class="food-spot-meta"><span>⌖</span>{f.city}<i></i><span>{f.cuisine.join(' · ')}</span></p>
                    {f.recommend && <p class="rd-spot-comment">“{f.recommend}”</p>}
                    <p class="rd-spot-must" data-dishes-display><span class="lab">喜欢的招牌菜</span><span class="dash">—</span><span class="val">{f.dishes.length ? f.dishes.join(' / ') : '还没记'}</span></p>
                  </div>
                  <aside class="rd-spot-actions">
                    {f.address ? <div class="rd-spot-address"><span class="rd-spot-address-text">{f.address}</span><button type="button" class="rd-copy" data-copy-address={f.address}>复制地址</button></div> : <p class="food-address-empty">地址待补充</p>}
                    {f.map && <a class="rd-map-link" href={f.map} target="_blank" rel="noopener noreferrer">打开地图 ↗</a>}
                    <details class="rd-dish-editor" data-dish-editor data-name={f.name} data-city={f.city} data-default={dishDefault(f.dishes)}>
                      <summary>记下我喜欢的菜 <span aria-hidden="true">›</span></summary>
                      <form data-dish-form>
                        <label><span class="sr-only">{f.name} 喜欢的招牌菜，多个菜名用逗号分隔</span><input type="text" data-dish-input value={dishDefault(f.dishes)} placeholder="例如：红烧肉，酒酿馒头" /></label>
                        <button type="submit">保存</button><span class="rd-save-status" aria-live="polite">仅保存在这台设备</span>
                      </form>
                    </details>
                  </aside>
                </article>
              ))}
            </section>
          ))}
        </section>

        <section id="rd-wishlist" class="food-section food-wishlist-section">
          <div class="food-section-heading">
            <div><p class="food-section-kicker">ON MY LIST</p><h2>想去吃 <span id="wishlist-section-count">{wishlist.length} 家</span></h2></div>
            <span class="food-section-aside">朋友种草，等一次出发</span>
          </div>
          {wishlist.length ? wishlist.map((f) => (
            <article class="rd-spot rd-spot--wishlist" data-food-spot data-status="wishlist" data-city={f.city} data-cuisines={f.cuisine.join('|')}>
              <div class="rd-spot-media"><img class="rd-spot-photo" src={f.image || '/food/hangzhou-longjing-shrimp.jpg'} alt={`${f.cuisine[0] || '中式'}菜系氛围图`} loading="lazy" /><span class="food-image-badge">菜系示意</span></div>
              <div class="rd-spot-content">
                <div class="food-spot-score food-spot-score--wishlist"><strong>想</strong><span>等一次探店</span></div>
                <div class="rd-spot-head"><h3 class="rd-spot-name">{f.name}</h3></div>
                <p class="food-spot-meta"><span>⌖</span>{f.city}<i></i><span>{f.cuisine.join(' · ')}</span></p>
                {f.recommend && <p class="rd-spot-comment">{f.recommend}</p>}
                {f.dishes.length > 0 && <p class="rd-spot-must"><span class="lab">想尝</span><span class="dash">—</span><span class="val">{f.dishes.join(' / ')}</span></p>}
              </div>
              <aside class="rd-spot-actions">
                {f.address ? <div class="rd-spot-address"><span class="rd-spot-address-text">{f.address}</span><button type="button" class="rd-copy" data-copy-address={f.address}>复制地址</button></div> : <p class="food-address-empty">地址待补充</p>}
                {f.map && <a class="rd-map-link" href={f.map} target="_blank" rel="noopener noreferrer">打开地图 ↗</a>}
              </aside>
            </article>
          )) : <p class="rd-empty rd-wishlist-empty">还没收录想去的餐厅。在 <code>src/data/food.json</code> 添加条目并将 <code>status</code> 设为 <code>wishlist</code>。</p>}
        </section>
        <p class="rd-empty food-no-results" id="rd-empty" hidden>没有找到符合条件的餐厅，换个筛选试试。</p>
      </div>
    </div>
  </div>

  <p class="rd-coda rd-reveal">Every place has a story worth keeping. <span class="zh">每一家，都有值得留下的味道。</span></p>
</BaseLayout>

<script>
  import { enhance } from '../../scripts/rd-enhance.js';
  import { initFoodFilters, initFoodTools } from '../../scripts/food-tools.js';
  enhance();
  initFoodTools();
  initFoodFilters();
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadFood } from '../../lib/food';
import raw from '../../data/food.json';

const items = loadFood(raw).sort((a, b) => b.score - a.score || b.date.localeCompare(a.date));

const cityCount = new Map<string, number>();
for (const it of items) cityCount.set(it.city, (cityCount.get(it.city) ?? 0) + 1);
const cities = [...cityCount.entries()].sort((a, b) => b[1] - a[1]);

const scored = items.filter((i) => i.score > 0);
const avg = scored.length ? (scored.reduce((s, i) => s + i.score, 0) / scored.length).toFixed(1) : '—';

// 评分分档：殿堂 9+ / 佳作 7–8 / 尚可 <7
const bands = [
  { name: '殿堂', en: 'The Hall', range: '9 – 10', test: (s: number) => s >= 9 },
  { name: '佳作', en: 'Fine Picks', range: '7 – 8', test: (s: number) => s >= 7 && s < 9 },
  { name: '尚可', en: 'Worth a Try', range: '< 7', test: (s: number) => s < 7 },
].map((b) => ({ ...b, items: items.filter((i) => b.test(i.score)) })).filter((b) => b.items.length);
---
<BaseLayout title="美食 · 私藏" description="私人觅食地图——亲自去过的宝藏馆子，按城市与评分检索。" wide>
  <nav class="rd-crumbs rd-reveal" aria-label="私藏内导航">
    <a href="/collections">← 私藏</a>
    <span class="sep">/</span>
    <span class="here">美食</span>
    <a href="/collections/media" style="font-family:var(--read);font-style:normal;letter-spacing:.08em">书影</a>
  </nav>

  <header class="rd-head rd-reveal" style="padding-top:26px">
    <span class="rd-mark" aria-hidden="true" data-parallax="-0.05" style="top:-30%">味</span>
    <div class="rd-head-text" style="max-width:520px">
      <p class="rd-kicker">私人觅食地图 · The Food Map</p>
      <div class="rd-title-row">
        <h1 class="rd-title">美食</h1>
        <span class="rd-seal" aria-hidden="true"><span>味</span></span>
      </div>
      <p class="rd-lede">都是亲自去过、值得回头的宝藏馆子。评分只对自己负责。</p>
    </div>
    <div class="rd-stats">
      <div class="rd-stat"><span class="rd-stat-num" id="rd-count">{items.length}</span><span class="rd-stat-lab">家馆子</span></div>
      <div class="rd-stat"><span class="rd-stat-num">{cityCount.size}</span><span class="rd-stat-lab">座城</span></div>
      <div class="rd-stat"><span class="rd-stat-num">{avg}</span><span class="rd-stat-lab">均分</span></div>
    </div>
  </header>

  <div class="rd-chips rd-reveal" id="rd-chips" role="group" aria-label="按城市筛选">
    <span class="rd-chips-lab">City —</span>
    <button type="button" class="rd-chip is-on" data-chip="*">全部 {items.length}</button>
    {cities.map(([c, n]) => <button type="button" class="rd-chip" data-chip={c}>{c} {n}</button>)}
  </div>

  <div id="rd-bands" style="transition:opacity .18s ease;padding-bottom:30px">
    {bands.map((b) => (
      <section class="rd-band">
        <div class="rd-band-head">
          <h2 class="rd-band-name">{b.name}</h2>
          <span class="rd-band-en">{b.en}</span>
          <span class="rd-band-rule"></span>
          <span class="rd-band-range">{b.range}</span>
        </div>
        {b.items.map((f) => (
          <article class="rd-spot" data-tags={f.city}>
            <div class="rd-spot-scorebox">
              <span class="rd-spot-score">{f.score > 0 ? f.score.toFixed(1) : '—'}</span>
              <span class="rd-spot-of">/ 10</span>
            </div>
            <div>
              <div class="rd-spot-head">
                <h3 class="rd-spot-name">{f.name}</h3>
                <span class="rd-spot-meta">{f.city} · {f.cuisine.join(' · ')}</span>
                {f.score >= 9 && <span class="rd-spot-seal" aria-label="值得回头">回头</span>}
              </div>
              {f.recommend && <p class="rd-spot-comment">{f.recommend}</p>}
              {f.dishes?.length > 0 && (
                <p class="rd-spot-must"><span class="lab">必点</span><span class="dash">—</span><span class="val">{f.dishes.join(' / ')}</span></p>
              )}
            </div>
          </article>
        ))}
      </section>
    ))}
    <p class="rd-empty" id="rd-empty" hidden>这座城还没有收录馆子。</p>
  </div>

  <p class="rd-coda rd-reveal">Only places worth a second visit. <span class="zh">只收值得再去一次的地方。</span></p>
</BaseLayout>

<script>
  import { enhance, chipFilter } from '../../scripts/rd-enhance.js';
  enhance();
  chipFilter({
    chips: document.getElementById('rd-chips'),
    list: document.getElementById('rd-bands'),
    items: () => [...document.querySelectorAll('.rd-spot')],
    count: document.getElementById('rd-count'),
    empty: document.getElementById('rd-empty'),
    onApply: () => {
      // 某档为空时连同档头一起隐藏
      document.querySelectorAll('.rd-band').forEach((band) => {
        band.hidden = ![...band.querySelectorAll('.rd-spot')].some((s) => !s.hidden);
      });
    },
  });
</script>

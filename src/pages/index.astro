---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '·');
// 中文阅读时长（约 350 字/分钟），结构编码真实信息
const readTime = (body = '') => Math.max(1, Math.round(body.replace(/\s/g, '').length / 350));

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const allGarden = await getCollection('garden');

const recent = [...allArticles]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const featured = recent[0];
const rest = recent.slice(1);

const allTags = [...new Set([...allArticles, ...allGarden].flatMap((e) => e.data.tags))];
const stats = { articles: allArticles.length, garden: allGarden.length, tags: allTags.length };
---
<BaseLayout title="归来" description="Evan 的个人写作博客与数字花园" wide>
  <section class="hero">
    <p class="kicker">写作博客 · 数字花园</p>
    <h1>归<span class="ret">来</span></h1>
    <p class="latin">A Place Where Words Come Home</p>
    <p class="tagline">记录 · 思考 · 与归处</p>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="track">
      <span class="s">★</span><span class="k">记录 · 思考 · 与归处</span>
      <span class="s">·</span><span>写长一点的东西</span>
      <span class="s">·</span><span>把想清楚的留下来</span>
      <span class="s">·</span><span class="k">EVERYTHING FINDS ITS WAY HOME</span>
      <span class="s">·</span><span>文字的归处 · 自 2026</span>
      <span class="s">★</span><span class="k">记录 · 思考 · 与归处</span>
      <span class="s">·</span><span>写长一点的东西</span>
      <span class="s">·</span><span>把想清楚的留下来</span>
      <span class="s">·</span><span class="k">EVERYTHING FINDS ITS WAY HOME</span>
      <span class="s">·</span><span>文字的归处 · 自 2026</span>
    </div>
  </div>

  <div class="colophon">
    <div class="col-who">
      <div class="avatar">归</div>
      <div><div class="name">Evan</div><div class="role">Writer · Gardener</div></div>
    </div>
    <div class="col-stats">
      <div><span class="n">{stats.articles}</span><span class="l">文章</span></div>
      <div><span class="n">{stats.garden}</span><span class="l">花园</span></div>
      <div><span class="n">{stats.tags}</span><span class="l">标签</span></div>
    </div>
    <div class="col-tags">
      {allTags.map((t) => <a class="tag" href={`/tags/${t}`}>{t}</a>)}
    </div>
  </div>

  <div class="section">
    <h2>最近文章</h2>
    <a class="sub" href="/articles">最新 {recent.length} 篇 · 查看全部 ▸</a>
  </div>

  {featured && (
    <a class="lead" href={`/articles/${featured.id}`}>
      <span class="flag">新</span>
      <div class="kind"><span class="dot"></span>{featured.data.tags[0]} · 读 {readTime(featured.body)} 分钟</div>
      <h2 class="lead-title">{featured.data.title}</h2>
      {featured.data.summary && <p class="lead-sum">{featured.data.summary}</p>}
      <div class="lead-foot">
        <span>{fmt(featured.data.date)}</span>
        <span class="go">读 ▸</span>
      </div>
    </a>
  )}

  {rest.length > 0 && (
    <div class="ledger">
      {rest.map((e) => (
        <a class="row" href={`/articles/${e.id}`}>
          <span class="date">{fmt(e.data.date)}</span>
          <span class="kind">{e.data.tags[0]}</span>
          <span class="rtitle">{e.data.title}</span>
          <span class="read">读 {readTime(e.body)} 分</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>

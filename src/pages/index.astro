---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';

const fmt = (d: Date) => d.toISOString().slice(0, 10);
// 中文阅读时长（约 350 字/分钟），结构编码真实信息
const readTime = (body = '') => `读 ${Math.max(1, Math.round(body.replace(/\s/g, '').length / 350))} 分钟`;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const allGarden = await getCollection('garden');

const articles = [...allArticles]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5)
  .map((e) => ({ url: `/articles/${e.id}`, title: e.data.title, meta: fmt(e.data.date), summary: e.data.summary, tag: e.data.tags[0], read: readTime(e.body) }));

const garden = [...allGarden]
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 5)
  .map((e) => ({ url: `/garden/${e.id}`, title: e.data.title, meta: `更新于 ${fmt(e.data.updated)}`, tag: e.data.tags[0], read: readTime(e.body) }));

const allTags = [...new Set([...allArticles, ...allGarden].flatMap((e) => e.data.tags))];
const stats = { articles: allArticles.length, garden: allGarden.length, tags: allTags.length };
---
<BaseLayout title="归来" description="Evan 的个人写作博客与数字花园" wide>
  <section class="hero">
    <div class="hero-grid">
      <div>
        <p class="kicker">写作博客 · 数字花园</p>
        <h1>归<span class="ret">来</span></h1>
        <p class="latin">A Place Where Words Come Home</p>
        <p class="tagline">记录 · 思考 · 与归处</p>
      </div>
      <div class="seal" aria-hidden="true"><span>归</span></div>
    </div>
  </section>

  <div class="ticker bleed" aria-hidden="true">
    <div class="track">
      <span class="s">★</span><span>记录</span><span class="s">·</span><span>思考</span><span class="s">·</span><span>与归处</span>
      <span class="s">★</span><span>EVERYTHING FINDS ITS WAY HOME</span><span class="s">·</span><span>归来 · 自 2026</span>
      <span class="s">★</span><span>记录</span><span class="s">·</span><span>思考</span><span class="s">·</span><span>与归处</span>
      <span class="s">★</span><span>EVERYTHING FINDS ITS WAY HOME</span><span class="s">·</span><span>归来 · 自 2026</span>
    </div>
  </div>

  <div class="home-shell">
    <main>
      <h2>最近文章</h2>
      <PostList items={articles} />

      <h2>花园近况</h2>
      <PostList items={garden} />
    </main>

    <aside class="aside">
      <div class="panel author">
        <div class="top">
          <div class="avatar">归</div>
          <div><h2>Evan</h2><div class="role">Writer · Gardener</div></div>
        </div>
        <div class="pbody">
          <p class="bio">个人写作博客与数字花园。在这里写长一点的东西，把想清楚的留下来。</p>
          <div class="stats">
            <div><span class="n">{stats.articles}</span><span class="l">文章</span></div>
            <div><span class="n">{stats.garden}</span><span class="l">花园</span></div>
            <div><span class="n">{stats.tags}</span><span class="l">标签</span></div>
          </div>
          <div class="social">
            <a href="https://github.com/nefelibata202" title="GitHub" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.6 2 12.3c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9 9 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.04 10.04 0 0 0 22 12.3C22 6.6 17.5 2 12 2z"/></svg></a>
            <a href="mailto:yrj8134517@gmail.com" title="Email" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14"/><path d="m3 7 9 6 9-6"/></svg></a>
            <a href="/rss.xml" title="RSS" aria-label="RSS"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor"/></svg></a>
          </div>
        </div>
      </div>

      <div class="panel">
        <p class="ptitle">常用标签</p>
        <div class="pbody-tags">
          {allTags.map((t) => <a class="tag" href={`/tags/${t}`}>{t}</a>)}
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

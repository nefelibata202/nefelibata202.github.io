---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '·');
// 中文阅读时长（约 350 字/分钟），结构编码真实信息
const readTime = (body = '') => Math.max(1, Math.round(body.replace(/\s/g, '').length / 350));

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const allGarden = await getCollection('garden');

const recent = [...allArticles]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
const featured = recent[0];
const rest = recent.slice(1);

const tagCounts = [...allArticles, ...allGarden]
  .flatMap((e) => e.data.tags)
  .reduce<Record<string, number>>((acc, t) => { acc[t] = (acc[t] ?? 0) + 1; return acc; }, {});
const allTags = Object.keys(tagCounts);
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([t]) => t);
const stats = { articles: allArticles.length, garden: allGarden.length, tags: allTags.length };
---
<BaseLayout title="归来" description="Evan 的个人写作博客与数字花园" wide>
  <div class="sy-home">
    <header class="sy-hero">
      <div class="sy-left">
        <div class="sy-mast">
          <div class="sy-big" aria-label="归来">归来</div>
          <div class="sy-seal" aria-hidden="true"><span>归</span></div>
        </div>
        <div class="sy-intro">
          <p class="sy-kick">写作博客 · 数字花园</p>
          <p class="sy-lat">A Place Where Words Come Home</p>
          <p class="sy-tag">记 录 · 思 考 · 与 归 处</p>
          <p class="sy-desc">写长一点的东西，把想清楚的留下来。让每一个念头，都找到它的归处。</p>
        </div>
      </div>

      {featured && (
        <a class="sy-feat" href={`/articles/${featured.id}`}>
          <span class="sy-tagn" aria-hidden="true"></span>
          <div class="sy-label">最 新 一 篇 <span class="en">Latest</span></div>
          <div class="sy-meta">{featured.data.tags[0]} · {fmt(featured.data.date)} · 读 {readTime(featured.body)} 分钟</div>
          <h2>{featured.data.title}</h2>
          {featured.data.summary && <p>{featured.data.summary}</p>}
          <span class="sy-go">继续阅读 →</span>
        </a>
      )}
    </header>

    <div class="sy-rule"></div>

    <div class="sy-layout">
      <div class="sy-main">
        <div class="sy-shead">
          <h3>更多文章</h3>
          <span class="en">Archive</span>
          <a class="more" href="/articles">查看全部 →</a>
        </div>

        {rest.length > 0 && (
          <div class="sy-list">
            {rest.map((e) => (
              <a class="sy-row" href={`/articles/${e.id}`}>
                <div class="top2">
                  <span class="k">{e.data.tags[0]}</span>
                  <span>{fmt(e.data.date)}</span>
                  <span>读 {readTime(e.body)} 分</span>
                </div>
                <div class="t">{e.data.title}</div>
              </a>
            ))}
          </div>
        )}
      </div>

      <aside class="sy-side">
        <div class="who">
          <div class="av">归</div>
          <div><div class="nm">Evan</div><div class="rl">Writer · Gardener</div></div>
        </div>
        <div class="st">
          <div><span class="n">{stats.articles}</span><span class="l">文章</span></div>
          <div><span class="n">{stats.garden}</span><span class="l">花园</span></div>
          <div><span class="n">{stats.tags}</span><span class="l">标签</span></div>
        </div>
        <p class="lbl">常用标签</p>
        <div class="tags">
          {topTags.map((t) => <a href={`/tags/${t}`}>{t}</a>)}
        </div>
        <p class="lbl">联系 · 订阅</p>
        <div class="soc">
          <a href="https://github.com/nefelibata202" title="GitHub" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.6 2 12.3c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9 9 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.04 10.04 0 0 0 22 12.3C22 6.6 17.5 2 12 2z"/></svg></a>
          <a href="mailto:yrj8134517@gmail.com" title="Email" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14"/><path d="m3 7 9 6 9-6"/></svg></a>
          <a href="/rss.xml" title="RSS" aria-label="RSS"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor"/></svg></a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const f = (d: Date) => d.toISOString().slice(0, 10);
  const rt = (body = '') => `读 ${Math.max(1, Math.round(body.replace(/\s/g, '').length / 350))} 分钟`;
  const items = (await getCollection('articles', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map((e) => ({
      url: `/articles/${e.id}`,
      title: e.data.title,
      date: f(e.data.date),
      summary: e.data.summary,
      tags: e.data.tags,
      read: rt(e.body),
    }));
  return paginate(items, { pageSize: 8 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---
<BaseLayout title="文章 · 归来" wide>
  <h1>文章</h1>
  <ArticleList items={page.data} page={page} activeTag={null} />
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

const fmt = (d: Date) => d.toISOString().slice(0, 10);
const readTime = (body = '') => `读 ${Math.max(1, Math.round(body.replace(/\s/g, '').length / 350))} 分钟`;
const items = (await getCollection('garden'))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .map((e) => ({ url: `/garden/${e.id}`, title: e.data.title, meta: `更新于 ${fmt(e.data.updated)}`, tag: e.data.tags[0], read: readTime(e.body) }));
---
<BaseLayout title="花园 · 归来">
  <h1>数字花园</h1>
  <p class="lead">慢慢生长、互相链接的笔记。</p>
  <PostList items={items} />
</BaseLayout>

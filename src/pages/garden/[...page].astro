---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const fmt = (d: Date) => d.toISOString().slice(0, 10);
  const garden = (await getCollection('garden'))
    .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
  const rediscoveries = garden.filter((e) => e.data.kind === 'rediscovery')
    .map((e) => ({ url: `/garden/${e.id}`, title: e.data.title, summary: e.data.summary, updated: fmt(e.data.updated) }));
  const notes = garden.filter((e) => e.data.kind === 'note')
    .map((e) => ({ url: `/garden/${e.id}`, title: e.data.title, tag: e.data.tags[0], updated: fmt(e.data.updated) }));
  // 单页全量索引：筛选 + 随手翻一株 取代分页
  return paginate(notes, { pageSize: 999, props: { rediscoveries } });
}) satisfies GetStaticPaths;

const { page, rediscoveries } = Astro.props;
const [latest, ...previous] = rediscoveries;
const notes = page.data;
const tagCount = new Map<string, number>();
for (const n of notes) if (n.tag) tagCount.set(n.tag, (tagCount.get(n.tag) ?? 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).map((e) => e[0]);
---
<BaseLayout title="花园 · 归来">
  <header class="rd-head rd-reveal">
    <span class="rd-mark" aria-hidden="true" data-parallax="-0.05">园</span>
    <div class="rd-head-text">
      <p class="rd-kicker">数字花园 · The Digital Garden</p>
      <div class="rd-title-row">
        <h1 class="rd-title">花园</h1>
        <span class="rd-seal" aria-hidden="true"><span>园</span></span>
      </div>
      <p class="rd-lede">重逢旧知，也让新的念头慢慢生长。</p>
    </div>
    <div class="rd-stats">
      <div class="rd-stat"><span class="rd-stat-num" id="rd-count">{notes.length}</span><span class="rd-stat-lab">株笔记</span></div>
      <button type="button" class="rd-random" id="rd-random">随手翻一株 ✳</button>
    </div>
  </header>

  {latest && (
    <section class="garden-rediscovery" aria-labelledby="rediscovery-heading">
      <div class="rediscovery-heading">
        <h2 id="rediscovery-heading">今日重逢</h2>
        <time datetime={latest.updated}>{latest.updated}</time>
      </div>
      <p class="rediscovery-intro">从几篇旧笔记出发，重新看懂一个小主题。</p>
      <a class="rediscovery-link" href={latest.url}>
        <h3>{latest.title}</h3>
        {latest.summary && <p>{latest.summary}</p>}
        <span class="rediscovery-read">读这一期</span>
      </a>
      {previous.length > 0 && (
        <details class="rediscovery-history">
          <summary>往期重逢（{previous.length}）</summary>
          <ul>{previous.map((entry) => (
            <li><a href={entry.url}>{entry.title}</a><time datetime={entry.updated}>{entry.updated}</time></li>
          ))}</ul>
        </details>
      )}
    </section>
  )}

  <h2 class="garden-notes-heading">园中笔记</h2>
  <div class="rd-chips rd-reveal" id="rd-chips" role="group" aria-label="按标签筛选">
    <span class="rd-chips-lab">Filter —</span>
    <button type="button" class="rd-chip is-on" data-chip="*">全部</button>
    {tags.map((t) => <button type="button" class="rd-chip" data-chip={t}>{t}</button>)}
  </div>

  <div class="rd-glist" id="rd-glist">
    {notes.map((n) => (
      <div class="rd-grow" data-tags={n.tag ?? ''}>
        <a class="rd-grow-link" href={n.url}>
          <span class="rd-grow-title">{n.title}</span>
          <span class="rd-grow-meta">
            {n.tag && <span class="rd-grow-tag">{n.tag}</span>}
            <span class="rd-grow-date">{n.updated}</span>
          </span>
        </a>
      </div>
    ))}
    <p class="rd-empty" id="rd-empty" hidden>这个标签下还没有笔记。</p>
  </div>

  <p class="rd-coda rd-reveal">Notes grow slowly here. <span class="zh">笔记在这里慢慢生长。</span></p>
</BaseLayout>

<style>
  .garden-rediscovery { margin: 4px 0 42px; padding: 25px 28px 28px; border: 1px solid var(--hair); border-top: 3px solid var(--seal); background: var(--paper); font-family: var(--read); }
  .rediscovery-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 20px; }
  .rediscovery-heading h2 { margin: 0; color: var(--seal); font-size: 20px; font-weight: 700; }
  .rediscovery-heading time { color: var(--muted); font-size: 13px; }
  .rediscovery-intro { color: var(--muted); font-size: 15px; line-height: 1.8; margin: 8px 0 22px; }
  .rediscovery-link { display: block; color: var(--ink); }
  .rediscovery-link h3 { font-size: clamp(25px, 3.5vw, 32px); line-height: 1.5; margin: 0 0 10px; }
  .rediscovery-link p { color: var(--muted); font-size: 17px; line-height: 1.9; max-width: 36em; margin: 0 0 20px; }
  .rediscovery-read { display: inline-block; color: var(--seal); font-size: 16px; border-bottom: 1px solid var(--seal); }
  .rediscovery-link:hover h3 { color: var(--seal); }
  .rediscovery-link:focus-visible { outline: 2px solid var(--seal); outline-offset: 8px; }
  .rediscovery-history { border-top: 1px solid var(--hair); margin-top: 24px; padding-top: 16px; font-size: 15px; }
  .rediscovery-history summary { cursor: pointer; color: var(--muted); }
  .rediscovery-history ul { padding-left: 20px; }
  .rediscovery-history li { margin: 12px 0; }
  .rediscovery-history a { color: var(--ink); }
  .rediscovery-history time { display: inline-block; margin-left: 12px; color: var(--muted); font-size: 12px; }
  .garden-notes-heading { font-family: var(--read); font-size: 23px; margin: 0 0 18px; }
  @media (max-width: 560px) { .garden-rediscovery { padding: 20px; } }
</style>

<script>
  import { enhance, chipFilter } from '../../scripts/rd-enhance.js';
  enhance();
  const rows = () => [...document.querySelectorAll('#rd-glist .rd-grow')];
  chipFilter({
    chips: document.getElementById('rd-chips'),
    list: document.getElementById('rd-glist'),
    items: rows,
    count: document.getElementById('rd-count'),
    empty: document.getElementById('rd-empty'),
  });
  // 随手翻一株：当前筛选内随机一株，平滑滚到并朱砂高亮
  let flashT;
  document.getElementById('rd-random')?.addEventListener('click', () => {
    const pool = rows().filter((r) => !r.hidden);
    if (!pool.length) return;
    const pick = pool[Math.floor(Math.random() * pool.length)];
    rows().forEach((r) => r.classList.remove('is-flash'));
    pick.classList.add('is-flash');
    const y = pick.getBoundingClientRect().top + scrollY - innerHeight * 0.38;
    scrollTo({ top: y, behavior: 'smooth' });
    clearTimeout(flashT);
    flashT = setTimeout(() => pick.classList.remove('is-flash'), 2400);
  });
</script>

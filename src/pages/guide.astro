---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('guide');
const panels = await Promise.all(
  entries.map(async (e) => {
    const { Content } = await render(e);
    return { data: e.data, Content };
  })
);

// 按 island id 排序：个人岛在前，信息岛在后
const order = ['people', 'philosophy', 'interests', 'fragmented-time', 'info-sources', 'knowledge-gaps'];
panels.sort((a, b) => order.indexOf(a.data.island) - order.indexOf(b.data.island));
---

<BaseLayout title="归图 · 个人导览">
  <div class="guide-layout">

    <!-- 左侧边栏 -->
    <aside class="guide-sidebar">
      <div class="guide-sidebar-logo">
        <a href="/" class="guide-back-link" aria-label="返回归来首页">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          归来
        </a>
        <span class="guide-logo-text">归图</span>
      </div>
      <p class="guide-sidebar-desc">个人知识导览</p>

      <nav class="guide-nav" aria-label="岛屿导航">
        {panels.map(({ data }, i) => (
          <button
            type="button"
            class:list={['guide-nav-item', i === 0 && 'active']}
            data-target={data.island}
            onclick="guideSwitch(this)"
          >
            <span class="guide-nav-icon" style={`--accent: var(--${data.accent})`}>
              {data.island === 'people' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              )}
              {data.island === 'philosophy' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
              )}
              {data.island === 'interests' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
              )}
              {data.island === 'travel' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              )}
              {data.island === 'fragmented-time' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              )}
              {data.island === 'info-sources' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              )}
              {data.island === 'knowledge-gaps' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              )}
            </span>
            <span class="guide-nav-text">
              <span class="guide-nav-title">{data.title}</span>
              <span class="guide-nav-en">{data.island.toUpperCase().replace(/-/g, ' ')}</span>
            </span>
          </button>
        ))}
      </nav>

      <div class="guide-sidebar-footer">
        <span>GUI TU</span>
        <span>2026</span>
      </div>
    </aside>

    <!-- 右侧内容 -->
    <main class="guide-content">
      {panels.map(({ data, Content }, i) => (
        <article
          class:list={['guide-section', i === 0 && 'active']}
          id={`guide-${data.island}`}
          data-island={data.island}
        >
          <header class="guide-section-header">
            <span class="guide-section-num" style={`--accent: var(--${data.accent})`}>
              / {String(order.indexOf(data.island) + 1).padStart(2, '0')}
            </span>
            <h2 class="guide-section-title">{data.title}</h2>
          </header>
          <div class="guide-section-body">
            <Content />
          </div>
        </article>
      ))}
    </main>

  </div>
</BaseLayout>

<script is:inline>
function guideSwitch(btn) {
  var target = btn.getAttribute('data-target');
  // 切换导航 active 状态
  document.querySelectorAll('.guide-nav-item').forEach(function(el) {
    el.classList.remove('active');
  });
  btn.classList.add('active');
  // 切换内容区 active 状态
  document.querySelectorAll('.guide-section').forEach(function(el) {
    el.classList.remove('active');
  });
  var section = document.getElementById('guide-' + target);
  if (section) section.classList.add('active');
  // 更新 URL（不刷新页面）
  history.replaceState(null, '', '/guide?island=' + target);
  // 滚动到顶部
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
</script>

<style>
/* ── 整体布局 ── */
.guide-layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  min-height: calc(100vh - 60px);
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}

/* ── 左侧边栏 ── */
.guide-sidebar {
  padding: 40px 24px 40px 0;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  border-right: 2px solid var(--hair);
}

.guide-sidebar-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 4px;
}

.guide-back-link {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--muted);
  text-decoration: none;
  padding: 4px 8px;
  border: 2px solid transparent;
  transition: all 0.12s;
}

.guide-back-link:hover {
  color: var(--ink);
  border-color: var(--line);
  background: var(--soft);
  box-shadow: var(--shadow-sm);
}

.guide-logo-text {
  font-family: var(--disp);
  font-size: 1.6rem;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.guide-sidebar-desc {
  font-size: 0.78rem;
  color: var(--muted);
  margin-bottom: 28px;
  padding-bottom: 16px;
  border-bottom: 2px solid var(--hair);
}

/* 导航列表 */
.guide-nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
}

.guide-nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border: 2px solid transparent;
  background: none;
  text-align: left;
  cursor: pointer;
  color: var(--ink);
  font-family: inherit;
  width: 100%;
  transition: all 0.12s;
}

.guide-nav-item:hover {
  background: var(--soft);
  border-color: var(--hair);
}

.guide-nav-item.active {
  background: var(--soft);
  border-color: var(--line);
  box-shadow: var(--shadow-sm);
}

.guide-nav-icon {
  width: 30px;
  height: 30px;
  border: 2px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--bg);
  color: var(--accent, var(--ink));
}

.guide-nav-item.active .guide-nav-icon {
  background: var(--accent, var(--gold));
  color: var(--on-gold);
}

.guide-nav-text {
  display: flex;
  flex-direction: column;
}

.guide-nav-title {
  font-family: var(--disp);
  font-size: 0.9rem;
  font-weight: 700;
  line-height: 1.3;
}

.guide-nav-en {
  font-family: var(--mono);
  font-size: 0.68rem;
  color: var(--muted);
  margin-top: 1px;
}

.guide-sidebar-footer {
  margin-top: auto;
  padding-top: 16px;
  border-top: 2px solid var(--hair);
  font-family: var(--mono);
  font-size: 0.68rem;
  color: var(--muted);
  display: flex;
  justify-content: space-between;
}

/* ── 右侧内容区 ── */
.guide-content {
  padding: 40px 0 60px 48px;
}

.guide-section {
  display: none;
}

.guide-section.active {
  display: block;
  animation: guideFadeIn 0.2s ease;
}

@keyframes guideFadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

.guide-section-header {
  margin-bottom: 28px;
  padding-bottom: 16px;
  border-bottom: 2px solid var(--line);
}

.guide-section-num {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--accent, var(--muted));
  letter-spacing: 0.1em;
  display: block;
  margin-bottom: 6px;
}

.guide-section-title {
  font-family: var(--disp);
  font-size: clamp(1.4rem, 3vw, 1.8rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.15;
}

.guide-section-body {
  font-family: var(--read);
  font-size: 0.92rem;
  line-height: 1.75;
}

.guide-section-body :global(h3) {
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--muted);
  margin: 24px 0 10px;
  padding-bottom: 6px;
  border-bottom: 2px solid var(--hair);
}

.guide-section-body :global(h4) {
  font-family: var(--read);
  font-size: 0.92rem;
  font-weight: 600;
  margin-bottom: 4px;
  line-height: 1.4;
}

.guide-section-body :global(p) {
  font-family: var(--read);
  color: var(--muted);
  font-size: 0.85rem;
  line-height: 1.65;
  margin-bottom: 6px;
}

.guide-section-body :global(hr) {
  border: none;
  border-top: 1.5px solid var(--hair);
  margin: 16px 0;
}

.guide-section-body :global(strong) {
  color: var(--ink);
  font-weight: 600;
}

.guide-section-body :global(ul),
.guide-section-body :global(ol) {
  margin: 8px 0;
  padding-left: 0;
  list-style: none;
}

.guide-section-body :global(li) {
  padding: 4px 0;
  font-family: var(--read);
  font-size: 0.88rem;
  line-height: 1.6;
  color: var(--muted);
}

.guide-section-body :global(li strong) {
  color: var(--ink);
}

/* ── 响应式 ── */
@media (max-width: 768px) {
  .guide-layout {
    grid-template-columns: 1fr;
    padding: 0 16px;
  }

  .guide-sidebar {
    position: static;
    height: auto;
    border-right: none;
    border-bottom: 2px solid var(--hair);
    padding: 20px 0;
  }

  .guide-nav {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4px;
  }

  .guide-nav-item {
    flex: 1;
    min-width: 90px;
    padding: 8px 10px;
  }

  .guide-nav-en {
    display: none;
  }

  .guide-sidebar-footer {
    display: none;
  }

  .guide-content {
    padding: 24px 0 40px;
  }
}
</style>

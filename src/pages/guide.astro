---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import peopleGroups from '../data/people.json';

// 归图 · 重构：六宫格 → 一条「归家的路」。
// 人物使用共用数据预览，其他岛屿保留 Markdown 正文。
const entries = await getCollection('guide');
const order = ['people', 'philosophy', 'interests', 'fragmented-time', 'knowledge-gaps'];
entries.sort((a, b) => order.indexOf(a.data.island) - order.indexOf(b.data.island));

const meta: Record<string, { en: string; note: string }> = {
  'people':          { en: 'People',          note: '我所欣赏与追随的人物。' },
  'philosophy':      { en: 'Philosophy',      note: '思考框架与人生观。' },
  'interests':       { en: 'Interests',       note: '长期喜好与痴迷领域。' },
  'fragmented-time': { en: 'Fragmented Time', note: '零散时间的最优解法。' },
  'knowledge-gaps':  { en: 'Open Questions',  note: '我愿意在碎片时间继续了解的问题。' },
};
const nums = ['壹', '贰', '叁', '肆', '伍', '陆'];

const rendered = [];
for (const e of entries) rendered.push({ entry: e, Content: (await render(e)).Content });
---
<BaseLayout title="归图 · 个人导览" description="个人知识导览——一张回家的地图：人物、人生哲学、兴趣、碎片时间，以及我想继续了解的问题。">
  <header class="rd-head rd-reveal" style="display:block">
    <span class="rd-mark" aria-hidden="true" data-parallax="-0.05" style="font-size:210px;top:-14%">图</span>
    <div class="rd-head-text" style="max-width:none">
      <p class="rd-kicker">个人知识导览 · An Atlas of One Mind</p>
      <div class="rd-title-row">
        <h1 class="rd-title">归图</h1>
        <span class="rd-seal" aria-hidden="true"><span>图</span></span>
      </div>
      <p class="rd-lede" style="max-width:32em">{entries.length} 座岛屿，一张回家的地图——我欣赏谁、信什么、被什么吸引、把时间花在哪，还有什么值得继续追问。</p>
    </div>
  </header>

  <div class="rd-atlas" id="rd-atlas">
    <span class="rd-rail" aria-hidden="true"></span>
    <span class="rd-rail-fill" id="rd-rail-fill" aria-hidden="true"></span>

    {rendered.map(({ entry, Content }, i) => (
      <section class="rd-station rd-reveal">
        <span class="rd-stamp"><span>{nums[i]}</span></span>
        <div>
          <div class="rd-station-head">
            <h2 class="rd-station-title"><a href={`/guide/${entry.data.island}`} style="color:inherit">{entry.data.title}</a></h2>
            <span class="rd-station-en">{meta[entry.data.island]?.en}</span>
          </div>
          <p class="rd-station-note">{meta[entry.data.island]?.note}</p>
          {entry.data.island === 'people' ? (
            <div class="people-preview">
              <div class="people-preview-faces" aria-hidden="true">
                {peopleGroups.flatMap(group => group.people.slice(0, 1)).map(person => (
                  <img src={person.image} alt="" width="64" height="80" loading="lazy" decoding="async" style={`object-position:${person.imagePosition}`} />
                ))}
              </div>
              <ul class="people-preview-list">
                {peopleGroups.map(group => (
                  <li><a href={`/guide/people#${group.id}`}><span>{group.title}</span><span>{group.people.map(person => person.name).join('、')}</span></a></li>
                ))}
              </ul>
              <a class="people-preview-open" href="/guide/people">翻开人物册 <span aria-hidden="true">↗</span></a>
            </div>
          ) : <div class="rd-station-body"><Content /></div>}
        </div>
      </section>
    ))}

    <div class="rd-atlas-coda rd-reveal">
      <span class="rd-seal" aria-hidden="true"><span>归</span></span>
      <p class="rd-atlas-coda-text">所有路径，最终归于一处。<span class="rd-atlas-coda-en">All roads on this map lead home.</span></p>
    </div>
  </div>
</BaseLayout>

<script>
  import { enhance } from '../scripts/rd-enhance.js';
  enhance();
  // 阅读进度：墨线随滚动填色
  const atlas = document.getElementById('rd-atlas');
  const fill = document.getElementById('rd-rail-fill');
  if (atlas && fill) {
    const onScroll = () => {
      const r = atlas.getBoundingClientRect();
      const pct = Math.max(0, Math.min(1, (innerHeight * 0.72 - r.top) / r.height));
      fill.style.height = (pct * 100).toFixed(2) + '%';
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
.people-preview { padding-top: 8px; }
.people-preview-faces { display: grid; grid-template-columns: repeat(5, minmax(0, 58px)); gap: 10px; margin: 0 0 22px; }
.people-preview-faces img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border: 1px solid var(--hair); background: var(--soft); }
.people-preview-list { list-style: none; margin: 0 0 22px; padding: 0; }
.people-preview-list li { border-bottom: 1px solid var(--hair); }
.people-preview-list a { display: grid; grid-template-columns: 72px minmax(0,1fr); gap: 16px; padding: 9px 0; font: .85rem/1.8 var(--read); }
.people-preview-list a > span:first-child { color: var(--ink); }
.people-preview-list a > span:last-child { color: var(--muted); }
.people-preview-list a:hover > span { color: var(--seal); }
.people-preview-open { display: inline-block; border-bottom: 2px solid var(--gold); padding-bottom: 4px; font: .9rem var(--read); }
.people-preview-open:hover { color: var(--seal); border-color: var(--seal); }
@media(max-width: 560px) {
  .people-preview-faces { grid-template-columns: repeat(5, minmax(0, 42px)); gap: 7px; }
  .people-preview-list a { grid-template-columns: 60px minmax(0,1fr); gap: 10px; font-size: .8rem; }
}
</style>

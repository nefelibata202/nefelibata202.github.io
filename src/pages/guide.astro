---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('guide');
const panels = await Promise.all(
  entries.map(async (e) => {
    const { Content } = await render(e);
    return { data: e.data, Content };
  })
);

const order = ['people', 'philosophy', 'interests', 'fragmented-time', 'info-sources', 'knowledge-gaps'];
panels.sort((a, b) => order.indexOf(a.data.island) - order.indexOf(b.data.island));
---

<BaseLayout title="归图 · 个人导览" description="个人知识导览——关于我、知识理念、兴趣、碎片时间、信息源、知识缺口。">
  <div class="guide-page">

    <!-- 顶部 header -->
    <header class="guide-header">
      <a href="/" class="guide-back-link" aria-label="返回归来首页">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        归来
      </a>
      <div class="guide-header-title">
        <p class="guide-kicker">个人知识导览</p>
        <h1 class="guide-title">归图</h1>
      </div>
    </header>

    <!-- 岛屿导航（sticky） -->
    <nav class="island-bar" aria-label="岛屿导航">
      {panels.map(({ data }, i) => (
        <button
          type="button"
          class:list={['island-pill', i === 0 && 'active']}
          data-target={data.island}
          onclick="guideSwitch(this)"
        >
          <span class="island-pill-icon" style={`--accent: var(--${data.accent})`}>
            {data.island === 'people' && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            )}
            {data.island === 'philosophy' && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            )}
            {data.island === 'interests' && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
            )}
            {data.island === 'travel' && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            )}
            {data.island === 'fragmented-time' && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            )}
            {data.island === 'info-sources' && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            )}
            {data.island === 'knowledge-gaps' && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            )}
          </span>
          <span class="island-pill-text">
            <span class="island-pill-title">{data.title}</span>
            <span class="island-pill-en">{data.island.toUpperCase().replace(/-/g, ' ')}</span>
          </span>
        </button>
      ))}
      <a href="/guide/websites" class="island-pill island-pill--link">
        <span class="island-pill-icon" style="--accent: var(--gold)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </span>
        <span class="island-pill-text">
          <span class="island-pill-title">网站</span>
          <span class="island-pill-en">WEBSITES</span>
        </span>
      </a>
    </nav>

    <!-- 内容区 -->
    <main class="guide-body">
      {panels.map(({ data, Content }, i) => (
        <article
          class:list={['guide-section', i === 0 && 'active']}
          id={`guide-${data.island}`}
          data-island={data.island}
        >
          <header class="guide-section-header">
            <span class="guide-section-num" style={`--accent: var(--${data.accent})`}>
              / {String(order.indexOf(data.island) + 1).padStart(2, '0')}
            </span>
            <h2 class="guide-section-title">{data.title}</h2>
          </header>
          <div class="guide-section-body">
            <Content />
          </div>
        </article>
      ))}
    </main>

  </div>
</BaseLayout>

<script is:inline>
function guideSwitch(btn) {
  var target = btn.getAttribute('data-target');
  // 切换导航 active 状态
  document.querySelectorAll('.island-pill').forEach(function(el) {
    el.classList.remove('active');
  });
  btn.classList.add('active');
  // 切换内容区 active 状态
  document.querySelectorAll('.guide-section').forEach(function(el) {
    el.classList.remove('active');
  });
  var section = document.getElementById('guide-' + target);
  if (section) section.classList.add('active');
  // 更新 URL
  history.replaceState(null, '', '/guide?island=' + target);
  // 滚动到内容区顶部
  var bar = document.querySelector('.island-bar');
  if (bar) {
    var top = bar.getBoundingClientRect().bottom + window.scrollY;
    window.scrollTo({ top: top, behavior: 'smooth' });
  }
}
</script>

<style>
/* ── 整体容器 ── */
.guide-page {
  max-width: 800px;
  margin: 0 auto;
  padding: 32px 28px 80px;
}

/* ── 顶部 header ── */
.guide-header {
  padding-bottom: 24px;
  border-bottom: 2px solid var(--line);
  margin-bottom: 0;
}

.guide-back-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--muted);
  text-decoration: none;
  padding: 4px 8px;
  border: 2px solid transparent;
  transition: all 0.12s;
  margin-bottom: 20px;
}

.guide-back-link:hover {
  color: var(--ink);
  border-color: var(--line);
  background: var(--soft);
  box-shadow: var(--shadow-sm);
}

.guide-kicker {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin: 0 0 2px;
}

.guide-title {
  font-family: var(--disp);
  font-size: clamp(2rem, 5vw, 2.8rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.05;
  margin: 0;
}

/* ── 岛屿导航（sticky） ── */
.island-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 16px 0;
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg);
  border-bottom: 2px solid var(--hair);
}

.island-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border: 2px solid var(--hair);
  background: var(--paper);
  color: var(--muted);
  text-decoration: none;
  cursor: pointer;
  font-family: inherit;
  transition: all 0.12s;
  white-space: nowrap;
}

.island-pill:hover {
  color: var(--ink);
  border-color: var(--line);
  background: var(--soft);
  box-shadow: var(--shadow-sm);
}

.island-pill.active {
  color: var(--ink);
  border-color: var(--line);
  background: var(--soft);
  box-shadow: var(--shadow-sm);
}

.island-pill-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border: 2px solid var(--line);
  background: var(--bg);
  color: var(--accent, var(--ink));
  flex-shrink: 0;
}

.island-pill.active .island-pill-icon {
  background: var(--accent, var(--gold));
  color: var(--on-gold);
}

.island-pill--link:hover .island-pill-icon {
  background: var(--gold);
  color: var(--on-gold);
}

.island-pill-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.island-pill-title {
  font-family: var(--disp);
  font-size: 0.82rem;
  font-weight: 700;
}

.island-pill-en {
  font-family: var(--mono);
  font-size: 0.6rem;
  color: var(--muted);
  margin-top: 1px;
}

/* ── 内容区 ── */
.guide-body {
  padding-top: 48px;
}

.guide-section {
  display: none;
}

.guide-section.active {
  display: block;
  animation: guideFadeIn 0.2s ease;
}

@keyframes guideFadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

.guide-section-header {
  margin-bottom: 28px;
  padding-bottom: 16px;
  border-bottom: 2px solid var(--line);
}

.guide-section-num {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--accent, var(--muted));
  letter-spacing: 0.1em;
  display: block;
  margin-bottom: 6px;
}

.guide-section-title {
  font-family: var(--disp);
  font-size: clamp(1.4rem, 3vw, 1.8rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.15;
}

.guide-section-body {
  font-family: var(--read);
  font-size: 0.92rem;
  line-height: 1.75;
}

.guide-section-body :global(h3) {
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--muted);
  margin: 24px 0 10px;
  padding-bottom: 6px;
  border-bottom: 2px solid var(--hair);
}

.guide-section-body :global(h4) {
  font-family: var(--read);
  font-size: 0.92rem;
  font-weight: 600;
  margin-bottom: 4px;
  line-height: 1.4;
}

.guide-section-body :global(p) {
  font-family: var(--read);
  color: var(--muted);
  font-size: 0.85rem;
  line-height: 1.65;
  margin-bottom: 6px;
}

.guide-section-body :global(hr) {
  border: none;
  border-top: 1.5px solid var(--hair);
  margin: 16px 0;
}

.guide-section-body :global(strong) {
  color: var(--ink);
  font-weight: 600;
}

.guide-section-body :global(ul),
.guide-section-body :global(ol) {
  margin: 8px 0;
  padding-left: 0;
  list-style: none;
}

.guide-section-body :global(li) {
  padding: 4px 0;
  font-family: var(--read);
  font-size: 0.88rem;
  line-height: 1.6;
  color: var(--muted);
}

/* 知识缺口岛专属 */
.guide-section[data-island="knowledge-gaps"] .guide-section-body :global(h2) {
  font-family: var(--disp);
  font-size: 1rem;
  font-weight: 800;
  text-transform: none;
  letter-spacing: -0.01em;
  color: var(--ink);
  margin: 28px 0 12px;
  padding: 10px 14px;
  border: 2px solid var(--line);
  border-bottom: none;
  background: var(--paper);
  box-shadow: var(--shadow-sm);
}

.guide-section[data-island="knowledge-gaps"] .guide-section-body :global(h2:first-of-type) {
  margin-top: 8px;
}

.guide-section[data-island="knowledge-gaps"] .guide-section-body :global(ul) {
  border: 2px solid var(--hair);
  border-top: none;
  margin: -12px 0 0;
  padding: 8px 14px 10px 28px;
  background: var(--soft);
  list-style: none;
}

.guide-section[data-island="knowledge-gaps"] .guide-section-body :global(li) {
  position: relative;
  padding: 5px 0 5px 2px;
  font-size: 0.85rem;
  line-height: 1.55;
}

.guide-section[data-island="knowledge-gaps"] .guide-section-body :global(li::before) {
  content: "☐";
  position: absolute;
  left: -20px;
  color: var(--muted);
  font-size: 0.8rem;
}

.guide-section[data-island="knowledge-gaps"] .guide-section-body :global(li strong) {
  color: var(--seal);
  font-weight: 600;
}

.guide-section[data-island="knowledge-gaps"] .guide-section-body :global(hr) {
  display: none;
}

/* ── 响应式 ── */
@media (max-width: 768px) {
  .guide-page {
    padding: 20px 16px 60px;
  }

  .island-bar {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-right: 16px;
  }

  .island-bar::-webkit-scrollbar {
    display: none;
  }

  .island-pill {
    flex-shrink: 0;
  }

  .guide-body {
    padding-top: 32px;
  }
}
</style>

---
interface Item { title: string; url: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="backlinks">
    <h2>链接到此页的笔记</h2>
    <ul class="post-list">
      {items.map((it) => (
        <li><a href={it.url}>{it.title}</a></li>
      ))}
    </ul>
  </section>
)}

---
interface Item { title: string; url: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="backlinks">
    <h2>反 向 链 接</h2>
    <ul>
      {items.map((it) => (
        <li><a class="bl-card" href={it.url}>{it.title}</a></li>
      ))}
    </ul>
  </section>
)}

---
interface Item { url: string; title: string; meta: string; summary?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<ul class="post-list">
  {items.map((it) => (
    <li>
      <a href={it.url}>{it.title}</a>
      {it.summary && <div class="summary">{it.summary}</div>}
      <div class="meta">{it.meta}</div>
    </li>
  ))}
</ul>

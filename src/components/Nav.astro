---
const path = Astro.url.pathname;
const active = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const links = [
  { href: '/articles', label: '文章' },
  { href: '/garden', label: '花园' },
  { href: '/collections', label: '收藏' },
  { href: '/about', label: '关于' },
];
---
<header class="site-header">
  <a href="/" class="brand" aria-label="归来 首页">
    <svg class="hui" viewBox="0 0 56 56" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="square" stroke-linejoin="miter">
      <path d="M18 6 H50 V50 H6 V18 H38 V38 H22 V28 H28" />
      <rect x="25" y="25" width="6" height="6" stroke="none" style="fill:var(--seal)" />
    </svg>
    <span class="gl">GUILAI</span>
  </a>
  <nav class="site-nav" aria-label="主导航">
    {links.map((l) => (
      <a href={l.href} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    <span class="nav-tools">
      <a class="nav-btn" href="/search" aria-current={active('/search') ? 'page' : undefined} title="搜索" aria-label="搜索">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
      </a>
      <button type="button" class="nav-btn theme-toggle" title="切换亮 / 暗" aria-label="切换亮暗模式">
        <span class="ico-moon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></svg></span>
        <span class="ico-sun"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2" /><path d="M12 1.8v3M12 19.2v3M4.4 4.4l2.1 2.1M17.5 17.5l2.1 2.1M1.8 12h3M19.2 12h3M4.4 19.6l2.1-2.1M17.5 6.5l2.1-2.1" /></svg></span>
      </button>
    </span>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const sysDark = matchMedia('(prefers-color-scheme: dark)').matches;
      const cur = root.dataset.theme || (sysDark ? 'dark' : 'light');
      const next = cur === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  })();
</script>

---
// Self-hosted fonts (bundled same-origin by Vite — no runtime CDN request)
import 'cn-fontsource-smiley-sans-oblique-regular/font.css'; // 得意黑 Smiley Sans，中文展示字（按 unicode-range 分块）
import 'cn-fontsource-lxgw-wen-kai-gb-screen/font.css';      // 霞鹜文楷，文章正文阅读字
import '@fontsource/archivo/700.css';                        // 拉丁展示字
import '@fontsource/archivo/900.css';
import '@fontsource/jetbrains-mono/400.css';                 // 数据 / 标签字
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  /** woff2 URLs to preload (e.g. above-the-fold display-font subsets) */
  preload?: string[];
}
const { title, description, wide = false, preload = [] } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script is:inline>
      // 首帧前套用已保存主题，避免闪烁；未设置则跟随系统
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {preload.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body>
    <div class:list={['wrap', wide && 'wrap--wide']}>
      <Nav />
      <main>
        <slot />
      </main>
    </div>
    <Footer />
    <button class="scroll-anchor" id="scroll-anchor" aria-label="跳至底部" data-dir="down" hidden>
      <svg class="ico-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
      <svg class="ico-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 15 12 9 18 15" /></svg>
    </button>
    <script is:inline>
      (function () {
        var btn = document.getElementById('scroll-anchor');
        function check() {
          var dH = document.documentElement.scrollHeight;
          var cH = document.documentElement.clientHeight;
          if (dH <= cH + 40) { btn.hidden = true; return; }
          btn.hidden = false;
          var ratio = window.scrollY / (dH - cH);
          var dir = ratio > 0.5 ? 'up' : 'down';
          if (btn.dataset.dir !== dir) {
            btn.dataset.dir = dir;
            btn.setAttribute('aria-label', dir === 'up' ? '回到顶部' : '跳至底部');
          }
        }
        window.addEventListener('scroll', check, { passive: true });
        window.addEventListener('resize', check, { passive: true });
        btn.addEventListener('click', function () {
          var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var beh = reduced ? 'instant' : 'smooth';
          if (btn.dataset.dir === 'up') {
            window.scrollTo({ top: 0, behavior: beh });
          } else {
            window.scrollTo({ top: document.documentElement.scrollHeight, behavior: beh });
          }
        });
        check();
      })();
    </script>
  </body>
</html>

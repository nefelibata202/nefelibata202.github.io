---
// Self-hosted fonts (bundled same-origin by Vite — no runtime CDN request)
import 'cn-fontsource-smiley-sans-oblique-regular/font.css'; // 得意黑 Smiley Sans，中文展示字（按 unicode-range 分块）
import 'cn-fontsource-lxgw-wen-kai-gb-screen/font.css';      // 霞鹜文楷，文章正文阅读字
import '@fontsource/archivo/700.css';                        // 拉丁展示字
import '@fontsource/archivo/900.css';
import '@fontsource/jetbrains-mono/400.css';                 // 数据 / 标签字
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // 首帧前套用已保存主题，避免闪烁；未设置则跟随系统
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <div class:list={['wrap', wide && 'wrap--wide']}>
      <Nav />
      <main>
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
